# ─────────────────────────────────────────────────────────────
# FoodHub — пример переменных окружения.
# Скопируй в .env и заполни значениями. .env в гит НЕ коммитим.
# Валидация схемы env — при старте backend (@nestjs/config), см. 01.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://foodhub:foodhub@localhost:5432/foodhub?schema=public

# Redis (кеш, очереди BullMQ, сессии, rate-limit, WS pub/sub)
REDIS_URL=redis://localhost:6379

# JWT (авторизация)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# SMS-провайдер (вход клиента по коду)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=FoodHub

# S3-совместимое хранилище (фото меню)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=foodhub
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Push-уведомления (Expo)
EXPO_ACCESS_TOKEN=

# Платёжный провайдер (онлайн-оплата, холдирование) — песочница
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
