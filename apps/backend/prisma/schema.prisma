generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branches  Branch[]

  @@map("cities")
}

model Restaurant {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  logoUrl     String? @map("logo_url")

  cuisineTypes  String[] @map("cuisine_types")
  slug          String   @unique
  showInCatalog Boolean  @default(true) @map("show_in_catalog")

  ratingFood     Decimal @default(0) @map("rating_food") @db.Decimal(3, 2)
  ratingDelivery Decimal @default(0) @map("rating_delivery") @db.Decimal(3, 2)
  reviewsCount   Int     @default(0) @map("reviews_count")

  commissionPercent Decimal @default(0) @map("commission_percent") @db.Decimal(5, 2)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branches  Branch[]

  @@map("restaurants")
}

model Branch {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  cityId       String  @map("city_id") @db.Uuid
  name         String?
  address      String
  phone        String

  // координаты
  latitude  Float?
  longitude Float?

  workingHours Json    @map("working_hours")
  hasDelivery  Boolean @default(true) @map("has_delivery")
  hasDineIn    Boolean @default(true) @map("has_dine_in")
  hasPickup    Boolean @default(true) @map("has_pickup")

  minOrderAmount Decimal @default(0) @map("min_order_amount") @db.Decimal(10, 2)

  // доставка
  deliveryBaseFee          Decimal  @default(0) @map("delivery_base_fee") @db.Decimal(10, 2)
  deliveryIncludedRadiusKm Decimal  @default(0) @map("delivery_included_radius_km") @db.Decimal(5, 2)
  deliveryPerKm            Decimal  @default(0) @map("delivery_per_km") @db.Decimal(10, 2)
  deliveryMaxRadiusKm      Decimal? @map("delivery_max_radius_km") @db.Decimal(5, 2)
  freeDeliveryMinOrder     Decimal? @map("free_delivery_min_order") @db.Decimal(10, 2)

  freeDeliveryRadiusKm Decimal? @map("free_delivery_radius_km") @db.Decimal(5, 2)

  // состояние
  acceptingOrders Boolean  @default(true) @map("accepting_orders")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, name])
  @@index([cityId])
  @@map("branches")
}
