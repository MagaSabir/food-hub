generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Города - справочник. По нему фильтр каталога. Не свободный текст, нет дублей
model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]

  @@map("cities")
}

//=======================================================
// Бренд - "кто это": имя, лого, кухни, рейтинг.
model Restaurant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  logoUrl       String?  @map("logo_url") // пока просто Url; возможно media-таблица потом
  cuisineTypes  String[] @map("cuisine_types") // ["суши","пицца"] - для фильтра
  slug          String   @unique
  // сркыт партнером из каталога (может быть активен, но не показаг)
  showInCatalog Boolean  @default(true) @map("show_in_catalog")

  // агрегаты отзывов
  ratingFood     Decimal @default(0) @map("rating_food") @db.Decimal(3, 2)
  ratingDelivery Decimal @default(0) @map("rating_delivery") @db.Decimal(3, 2)
  reviewsCount   Int     @default(0) @map("reviews_count")

  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(5, 2) // на будущее. возможно и не понадобится
  // isActive - выключен платформой (бренд отключен целиком)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  branches Branch[]
}

model Branch {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid // чей бренд
  cityId       String  @map("city_id") @db.Uuid // в каком городе
  name         String?
  address      String
  phone        String

  // координаты - Float (измерения; дистанция считается во floating-point)
  latitude  Float? // широта
  longitude Float? // долгота

  workingHours Json    @map("working_hours") // расписание по дням; "открыто сейчас" вычисляем из него
  hasDelivery  Boolean @default(true) @map("has_delivery")
  hasDineIn    Boolean @default(true) @map("has_dine_in")
  hasPickup    Boolean @default(true) @map("has_pickup")

  minOrderAmount Decimal @default(0) @map("min_order_amount") @db.Decimal(10, 2)

  // доставка (радиусная модель)
  deliveryBaseFee          Decimal  @default(0) @map("delivery_base_fee") @db.Decimal(10, 2) // базовая цена
  deliveryIncludedRadiusKm Decimal  @default(0) @map("delivery_included_radius_km") @db.Decimal(5, 2) // км в базовой цене
  deliveryPerKm            Decimal  @default(0) @map("delivery_per_km") @db.Decimal(10, 2) // доплата за км сверх
  deliveryMaxRadiusKm      Decimal? @map("delivery_max_radius_km") @db.Decimal(5, 2) // дальше не возим
  freeDeliveryMinOrder     Decimal? @map("free_delivery_min_order") @db.Decimal(10, 2) // бесплатно от суммы

  // состояние
  acceptingOrders Boolean  @default(true) @map("accepting_orders") // ручной тумблер приёма заказов
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // у точки есть бренд (restaurant); чтобы его найти, возьми мой restaurantId и найди Restaurant с таким id; если тот Restaurant удаляют — удали и меня
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, name]) // уникальность + индекс по левой
  @@index([cityId])
  @@map("branches")
}
