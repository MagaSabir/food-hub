generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]

  @@map("cities")
}

model Restaurant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  logoUrl       String?  @map("logo_url")
  cuisineTypes  String[] @map("cuisine_types")
  slug          String   @unique
  showInCatalog Boolean  @default(true) @map("show_in_catalog")

  ratingFood     Decimal @default(0) @map("rating_food") @db.Decimal(3, 2)
  ratingDelivery Decimal @default(0) @map("rating_delivery") @db.Decimal(3, 2)
  reviewsCount   Int     @default(0) @map("reviews_count")

  commissionPercent Decimal  @default(0) @map("commission_percent") @db.Decimal(5, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  branches       Branch[]
  staffUsers     StaffUser[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  favorites      UserFavorite[]

  @@map("restaurants")
}

model Branch {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  cityId       String  @map("city_id") @db.Uuid
  name         String?
  address      String
  phone        String

  latitude  Float?
  longitude Float?

  workingHours Json    @map("working_hours")
  hasDelivery  Boolean @default(true) @map("has_delivery")
  hasDineIn    Boolean @default(true) @map("has_dine_in")
  hasPickup    Boolean @default(true) @map("has_pickup")

  minOrderAmount Decimal @default(0) @map("min_order_amount") @db.Decimal(10, 2)

  deliveryBaseFee          Decimal  @default(0) @map("delivery_base_fee") @db.Decimal(10, 2)
  deliveryIncludedRadiusKm Decimal  @default(0) @map("delivery_included_radius_km") @db.Decimal(5, 2)
  deliveryPerKm            Decimal  @default(0) @map("delivery_per_km") @db.Decimal(10, 2)
  deliveryMaxRadiusKm      Decimal? @map("delivery_max_radius_km") @db.Decimal(5, 2)
  freeDeliveryMinOrder     Decimal? @map("free_delivery_min_order") @db.Decimal(10, 2)
  freeDeliveryRadiusKm     Decimal? @map("free_delivery_radius_km") @db.Decimal(5, 2)

  acceptingOrders Boolean  @default(true) @map("accepting_orders")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  city       City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  staffUsers StaffUser[]

  @@unique([restaurantId, name])
  @@index([cityId])
  @@map("branches")
}

enum ItemType {
  DISH
  DRINK
}

enum ModifierType {
  SINGLE
  MULTIPLE
}

model MenuCategory {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid

  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  itemType     ItemType @default(DISH) @map("item_type")

  name        String
  description String?
  composition String?
  weight      String?
  volume      String?
  calories    Int?

  price         Decimal   @db.Decimal(10, 2)
  discountPrice Decimal?  @map("discount_price") @db.Decimal(10, 2)
  discountUntil DateTime? @map("discount_until")

  photos      String[]
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  modifierGroups ModifierGroup[]

  @@index([categoryId, sortOrder])
  @@index([restaurantId])
  @@map("menu_items")
}

model ModifierGroup {
  id         String @id @default(uuid()) @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid

  name          String
  type          ModifierType
  isRequired    Boolean      @default(false) @map("is_required")
  minSelections Int          @default(0) @map("min_selections")
  maxSelections Int?         @map("max_selections")
  sortOrder     Int          @default(0) @map("sort_order")

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId, sortOrder])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String @id @default(uuid()) @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid

  name        String
  priceDelta  Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isAvailable Boolean @default(true) @map("is_available")
  sortOrder   Int     @default(0) @map("sort_order")

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId, sortOrder])
  @@map("modifier_options")
}

enum Role {
  CLIENT
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  PLATFORM_ADMIN
}

model User {
  id String @id @default(uuid()) @db.Uuid

  phone String  @unique
  name  String?

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices   UserDevice[]
  favorites UserFavorite[]

  @@map("users")
}

model UserFavorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("user_favorites")
}

model UserDevice {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  expoPushToken String  @map("expo_push_token")
  platform      String?

  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expoPushToken])
  @@index([userId])
  @@map("user_devices")
}

model StaffUser {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  branchId     String? @map("branch_id") @db.Uuid

  email        String @unique
  passwordHash String @map("password_hash")
  role         Role

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([branchId])
  @@map("staff_users")
}

model PlatformAdmin {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_admins")
}
